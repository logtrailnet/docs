---
import type { Props } from '@astrojs/starlight/props';
import Default from '@astrojs/starlight/components/Head.astro';

const { entry, slug } = Astro.props;
const { url } = Astro;
const base = 'https://docs.logtrail.net';
const canonical = new URL(url.pathname, base).toString();

// Dynamic Breadcrumb schema based on URL segments
const segments = url.pathname.split('/').filter(Boolean);
const breadcrumbItems = [
  {
    "@type": "ListItem",
    "position": 1,
    "name": "Docs",
    "item": base + "/"
  },
  ...segments.map((segment, i) => ({
    "@type": "ListItem",
    "position": i + 2,
    "name": segment
      .replace(/-/g, ' ')
      .replace(/\b\w/g, c => c.toUpperCase()),
    "item": `${base}/${segments.slice(0, i + 1).join('/')}/`
  }))
];

// Organization & SoftwareApplication Schema
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Logtrail",
  "url": "https://logtrail.net",
  "logo": base + "/favicon.svg"
};

const appSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Logtrail",
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "Web",
  "url": "https://logtrail.net",
  "description": "The logging platform built for AI-era apps. One integration gives you internal debugging logs and a user-facing activity trail.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};

const searchSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "url": base + "/",
  "name": "Logtrail Docs",
  "potentialAction": {
    "@type": "SearchAction",
    "target": base + "/search?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
};

// Fallback SEO values
const siteTitle = 'Logtrail Docs';

let displayTitle = '';
if (entry?.data?.title && entry.data.title.toLowerCase() !== 'logtrail') {
  displayTitle = entry.data.title;
} else if (slug) {
  displayTitle = slug.split('/').pop()?.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase()) || '';
} else if (url.pathname !== '/') {
  displayTitle = url.pathname.split('/').filter(Boolean).pop()?.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase()) || '';
}

const pageTitle = displayTitle ? `${displayTitle} | ${siteTitle}` : siteTitle;
const description = entry?.data?.description || 'The high-performance, AI-friendly logging platform for modern engineering teams.';
---

<Default {...Astro.props}><slot /></Default>

<title>{pageTitle}</title>
<link rel="canonical" href={canonical} />
<meta name="description" content={description} />

<!-- Open Graph / Social -->
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content="Logtrail Docs" />
<meta property="og:type" content="website" />

<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />

<!-- Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(appSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(searchSchema)} />
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbItems
})} />

<!-- Client-side title fix to ensure dynamic navigation updates work as expected -->
<script is:inline define:vars={{ pageTitle }}>
  document.title = pageTitle;
</script>
